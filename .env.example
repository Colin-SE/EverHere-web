# 复制为 .env，替换密码和随机密钥；不要提交真实配置。
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://life_album:change-me@127.0.0.1:3306/life_album?charset=utf8mb4
SESSION_COOKIE_SECURE=false
# 多进程部署时使用 Redis 等共享限速存储。
RATELIMIT_STORAGE_URI=memory://

# 本机 MySQL 与共同云 PostgreSQL 分开；留空时不连接任何共同云服务。
CLOUD_API_URL=
# 必须与安卓版归档/共同后端区域一致，不能把 CN 和 global 资料自动互转。
CLOUD_REGION=cn
EVENT_TIMEZONE=Asia/Shanghai
