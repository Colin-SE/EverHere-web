# 复制为 .env，替换密码和随机密钥；不要提交真实配置。
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://life_album:change-me@127.0.0.1:3306/life_album?charset=utf8mb4
SESSION_COOKIE_SECURE=false
# 多进程部署时使用 Redis 等共享限速存储。
RATELIMIT_STORAGE_URI=memory://

# 事件日期的默认时区。
EVENT_TIMEZONE=Asia/Shanghai

# 默认关闭。先迁移、验证 SMTP 和反向代理，再启用；只部署中国区。
SHARED_IDENTITY_ENABLED=false
# 仅用于后端绑定 127.0.0.1、同机 Nginx 覆写转发头的部署。
TRUST_LOOPBACK_PROXY=false
# 使用本机安全生成的 32 字节随机值（64 位十六进制），不要复制示例或提交真实值。
IDENTITY_SECRET=
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=465
IDENTITY_SMTP_TLS=implicit
IDENTITY_SMTP_USER=
# SMTP 授权码通过服务器配置输入，不是聊天或 GitHub。
IDENTITY_SMTP_PASSWORD=
IDENTITY_MAIL_FROM=
